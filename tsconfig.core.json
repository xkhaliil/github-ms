{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true
  },
  "include": [
    "core/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "api/**/*.ts",
    "vite.config.ts"
  ]
}
