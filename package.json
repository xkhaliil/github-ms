{
  "name": "gitms",
  "version": "0.1.0",
  "description": "Reads what your GitHub repositories actually do, writes the descriptions, topics and READMEs they are missing, and shows you every word before anything is pushed.",
  "keywords": [
    "github",
    "readme",
    "readme-generator",
    "claude",
    "anthropic",
    "repository",
    "documentation",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build && npm run typecheck",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "qa:seed": "tsx scripts/seed-fixtures.mjs",
    "qa:shoot": "node scripts/shoot.mjs",
    "brand:render": "node scripts/render-brand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/static": "^8.2.0",
    "@octokit/plugin-retry": "^8.0.1",
    "@octokit/plugin-throttling": "^11.0.1",
    "@octokit/rest": "^22.0.0",
    "dompurify": "^3.4.14",
    "fastify": "^5.6.0",
    "marked": "^18.0.11",
    "open": "^10.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
